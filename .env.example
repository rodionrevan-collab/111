APP_NAME=AI Story Factory
APP_HOST=0.0.0.0
APP_PORT=8000
DATA_DIR=./data

# AI / LLM
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# AI video generation
# Uses the same API key as LLM when VIDEO_API_KEY is empty.
VIDEO_BASE_URL=https://api.openai.com/v1
VIDEO_API_KEY=
VIDEO_MODEL=sora-2
VIDEO_SIZE=720x1280
VIDEO_SECONDS=8

# FFmpeg
FFMPEG_BIN=ffmpeg

# Optional platform credentials
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://127.0.0.1:8000/api/auth/youtube/callback

TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://127.0.0.1:8000/api/auth/tiktok/callback
